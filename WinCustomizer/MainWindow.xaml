<ui:FluentWindow x:Class="WinCustomizer.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding ApplicationTitle, Mode=OneWay}"
        Height="600" Width="900"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">

    <Grid>

        <ui:TitleBar 
            x:Name="AppTitleBar"
            Title="{Binding ApplicationTitle, Mode=OneWay}" 
            Icon="{ui:SymbolIcon Symbol=Apps24}" />

        <ui:NavigationView 
            x:Name="RootNavigation" 
            TitleBar="{Binding ElementName=AppTitleBar, Mode=OneWay}"
            BreadcrumbBar="{Binding ElementName=AppBreadcrumbBar, Mode=OneWay}"
            
            PaneTitle="Главное меню"
            PaneDisplayMode="Left" 
            IsPaneOpen="False" 
            OpenPaneLength="230"
            IsBackButtonVisible="Auto"
            MenuItemsSource="{Binding MenuItems}"
            FooterMenuItemsSource="{Binding FooterMenuItems}">

            <ui:NavigationView.Header>
                <ui:BreadcrumbBar x:Name="AppBreadcrumbBar" Margin="32,10,32,10" />
            </ui:NavigationView.Header>

        </ui:NavigationView>
    </Grid>

</ui:FluentWindow>